{
  "name": "delta-tigre-lancha",
  "version": "1.0.0",
  "description": "Videojuego de lancha colectiva navegando por el Delta de Tigre - Estilo Minecraft/Roblox",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "world:import": "tsx scripts/osm/import.ts",
    "map:update": "bash scripts/osm/update-map.sh"
  },
  "dependencies": {
    "@babylonjs/core": "^7.0.0",
    "@babylonjs/gui": "^7.0.0",
    "@babylonjs/loaders": "^7.54.3",
    "@babylonjs/materials": "^7.0.0",
    "@fontsource-variable/fraunces": "^5.2.8",
    "@fontsource-variable/inter": "^5.2.8",
    "earcut": "^3.2.4",
    "gsap": "^3.13.0"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.3.0",
    "ajv": "^8.20.0",
    "tsx": "^4.23.15",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vitest": "^2.1.9"
  }
}
